{
  "uid": "notes-alamin",
  "title": "Notes API — alamin",
  "tags": ["exam", "alamin"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "App scrape UP",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PROM" },
      "targets": [
        { "expr": "up{job=\"notes-api\"}", "legendFormat": "up" }
      ]
    },
    {
      "type": "stat",
      "title": "Requests in flight (ekhon)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PROM" },
      "targets": [
        { "expr": "http_requests_in_flight", "legendFormat": "in flight" }
      ]
    },
    {
      "type": "stat",
      "title": "Scrape duration (s)",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PROM" },
      "targets": [
        { "expr": "scrape_duration_seconds{job=\"notes-api\"}", "legendFormat": "scrape" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request rate (req/s) by route",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "PROM" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(http_requests_total[1m])) by (route)", "legendFormat": "{{route}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency by route",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "PROM" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "DB queries per request (N+1 ekhane dekha jay)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "PROM" },
      "targets": [
        { "expr": "rate(db_queries_per_request_sum[5m]) / rate(db_queries_per_request_count[5m])", "legendFormat": "{{route}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "DB query rate by query_name",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "PROM" },
      "targets": [
        { "expr": "sum(rate(db_query_duration_seconds_count[5m])) by (query_name)", "legendFormat": "{{query_name}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 DB query time by query_name",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "PROM" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(db_query_duration_seconds_bucket[5m])) by (le, query_name))", "legendFormat": "{{query_name}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "5xx rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "PROM" },
      "targets": [
        { "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m])) by (route)", "legendFormat": "{{route}}" }
      ]
    }
  ]
}
