[Unit]
Description=My App alamin (backend 2)
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=simple
User=myappuser_alamin
Group=myappuser_alamin
Environment=PORT=30102
Environment=APP_NAME=backend-30102
ExecStart=/usr/bin/node /srv/app_alamin/src/app.js
Restart=on-failure
RestartSec=1
SyslogIdentifier=myapp2_alamin

[Install]
WantedBy=multi-user.target
